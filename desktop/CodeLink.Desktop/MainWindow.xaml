<Window x:Class="CodeLink.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Code Link · 桌面控制台" Width="1250" Height="850" MinWidth="1000" MinHeight="650" Background="#F5F2E9" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="1*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Right" Content="扫描" Click="ScanProcesses"/><TextBlock Text="命令行" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
     <ListBox Grid.Row="1" x:Name="ExternalProcessList" SelectionChanged="SelectExternalProcess" Background="#FCFBF6" BorderBrush="#DDDFD4" Padding="5" FontSize="12" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border BorderThickness="2" Padding="9" CornerRadius="4"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D9D8CE"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="#E5EADB"/><Setter Property="BorderBrush" Value="#52745B"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Label}" TextWrapping="Wrap" ToolTip="{Binding Label}"/></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <DockPanel Grid.Row="2" Margin="0,12,0,4"><Button DockPanel.Dock="Right" Content="连接设备" Click="PairDevice"/><TextBlock Text="移动设备" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
     <ListBox Grid.Row="3" x:Name="DeviceList" Background="#FCFBF6" BorderBrush="#DDDFD4" Padding="6" FontSize="12"/>
     <Button Grid.Row="4" x:Name="MapMobileButton" Content="映射到移动端" Click="MapControl" Margin="0,10,0,0" Background="#E9BB45"/>
    </Grid>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,10,0,12"><StackPanel><TextBlock x:Name="SessionTitle" Text="选择受控命令行" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="SessionSubtitle" Text="运行输出在此观察" FontSize="12" Foreground="#66776B" Margin="0,5,0,0"/></StackPanel></DockPanel>
     <TextBox Grid.Row="1" x:Name="Output" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#192D27" Foreground="#E4EBDD" FontFamily="Cascadia Mono,Consolas" FontSize="14" Padding="18" BorderThickness="0"/>
     <TextBlock Grid.Row="2" x:Name="PendingStatus" Foreground="#805F14" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="3" Text="输入请在 PC 的命令行中进行；此处仅用于观察输出。" FontSize="11" Foreground="#66776B" Margin="0,14,0,0"/>
    </Grid>
   </Grid>
   <Grid Grid.Row="1" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Footer" Text="完全本地 · USB / Wi-Fi / 蓝牙" FontSize="11" Foreground="#66776B" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
    <TextBlock Grid.Column="1" x:Name="HostStatus" Text="正在连接本地代理…" HorizontalAlignment="Right" FontSize="11" Foreground="#66776B"/>
   </Grid>
  </Grid>
  <Grid x:Name="Splash" Background="#F5F2E9"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Image x:Name="SplashImage" Width="360" Height="240" Stretch="Uniform"/><TextBlock Text="Code Link" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,25,0,0"/><TextBlock Text="连接你的另一块屏幕" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid>
 </Grid>
</Window>
